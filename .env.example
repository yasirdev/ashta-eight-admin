NEXT_PUBLIC_API_BASE_URL=https://app.ashtaeight.com/api

# Sub-path the admin app is served under. Build-time inlined into both
# next.config.ts (basePath) and the client bundle (client.ts fetch prefix).
# Defaults to '' for local dev without a basePath.
# PRODUCTION BUILDS MUST SET THIS to /admin — forgetting it silently drops the
# /admin prefix and breaks auth cookies + routing.
NEXT_PUBLIC_BASE_PATH=/admin
